# SQLite for local dev. For production use Postgres:
#   1) set provider = "postgresql" in prisma/schema.prisma
#   2) DATABASE_URL="postgresql://user:pass@host:5432/buddy"
DATABASE_URL="file:./dev.db"

# LLM (optional — without any of these, Resume Buddy and Law Buddy fall back to their
# rule-based engines). You can set just one provider, or several: every one you set a key for is
# used, tried in the order below, with automatic failover if one is down or overloaded (common on
# free tiers — see README). Setting at least two is recommended for that reason.
#
# 1) Google Gemini — free tier via Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
#
# 2) OpenRouter — free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nex-agi/nex-n2.5-mini:free"
#
# 3) Groq — free tier, and usually the least congested of the three: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Admin dashboard login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-long-password"
# 32+ random chars, e.g. `openssl rand -base64 32`
ADMIN_JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Used for canonical URLs, sitemap, and JSON-LD
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Law Buddy — free API token from https://www.courtlistener.com/profile/api/ (sign in, then "API")
COURTLISTENER_API_TOKEN=""
